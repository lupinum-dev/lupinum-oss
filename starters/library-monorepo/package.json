{
  "name": "{{SLUG}}-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "homepage": "https://{{DOMAIN}}",
  "packageManager": "pnpm@11.28.5",
  "scripts": {
    "dev": "pnpm -r --parallel --filter './packages/*' dev",
    "build": "pnpm -r --filter './packages/*' build && pnpm docs:build && node scripts/agent-docs.mjs && pnpm -r --filter './packages/*' exec publint",
    "lint": "eslint . && node scripts/lint-changesets.mjs",
    "format": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "docs:dev": "pnpm --dir docs dev",
    "docs:build": "pnpm --dir docs build",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && node scripts/audit-deps.mjs",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@nuxt/eslint-config": "^1.17.0",
    "@types/node": "26.6.4",
    "eslint": "^10.9.0",
    "pkg-pr-new": "0.0.90",
    "publint": "0.3.25",
    "typescript": "~7.0.0",
    "vitest": "^4.1.8"
  }
}
