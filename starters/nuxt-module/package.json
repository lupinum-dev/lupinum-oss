{
  "name": "{{PACKAGE_NAME}}",
  "version": "0.1.0",
  "description": "{{DESCRIPTION}}",
  "type": "module",
  "license": "MIT",
  "author": "Lupinum OG <info@lupinum.com> (https://lupinum.com)",
  "homepage": "https://{{DOMAIN}}",
  "repository": { "type": "git", "url": "git+https://github.com/{{REPOSITORY}}.git" },
  "bugs": { "url": "https://github.com/{{REPOSITORY}}/issues" },
  "packageManager": "pnpm@11.21.0",
  "engines": { "node": "^22.14.0 || ^24.0.0 || ^26.0.0" },
  "exports": {
    ".": { "types": "./dist/types.d.mts", "import": "./dist/module.mjs" },
    "./agent-docs": "./dist/agent/AGENTS.md"
  },
  "main": "./dist/module.mjs",
  "types": "./dist/types.d.mts",
  "files": ["dist", "CHANGELOG.md"],
  "publishConfig": { "access": "public" },
  "scripts": {
    "dev": "pnpm dev:prepare && nuxt dev playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt prepare playground",
    "build": "nuxt-module-build prepare && nuxt-module-build build && pnpm docs:build && node scripts/agent-docs.mjs && publint",
    "lint": "eslint . && node scripts/lint-changesets.mjs",
    "format": "eslint . --fix",
    "typecheck": "pnpm dev:prepare && vue-tsc --noEmit",
    "test": "vitest run",
    "docs:dev": "pnpm --dir docs dev",
    "docs:build": "pnpm --dir docs build",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && node scripts/audit-deps.mjs",
    "changeset": "changeset"
  },
  "peerDependencies": {
    "nuxt": "^4.0.0"
  },
  "dependencies": {
    "@nuxt/kit": "^4.5.2"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@nuxt/eslint-config": "^1.17.0",
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "^4.5.2",
    "@nuxt/test-utils": "^4.1.0",
    "@types/node": "26.6.4",
    "eslint": "^10.9.0",
    "nuxt": "^4.5.2",
    "pkg-pr-new": "0.0.90",
    "publint": "0.3.25",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11",
    "vue": "^3.5.42",
    "vue-tsc": "^3.3.11"
  }
}
