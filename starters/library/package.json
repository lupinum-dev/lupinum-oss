{
  "name": "{{PACKAGE_NAME}}",
  "version": "0.1.0",
  "description": "{{DESCRIPTION}}",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "author": "Lupinum OG <info@lupinum.com> (https://lupinum.com)",
  "homepage": "https://{{DOMAIN}}",
  "repository": { "type": "git", "url": "git+https://github.com/{{REPOSITORY}}.git" },
  "bugs": { "url": "https://github.com/{{REPOSITORY}}/issues" },
  "packageManager": "pnpm@11.21.0",
  "engines": { "node": "^22.14.0 || ^24.0.0 || ^26.0.0" },
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md", "CHANGELOG.md", "LICENSE"],
  "publishConfig": { "access": "public" },
  "scripts": {
    "audit:all": "pnpm audit",
    "build": "tsup src/index.ts --format esm --dts --clean",
    "docs:build": "pnpm --dir docs build",
    "docs:dev": "pnpm --dir docs dev",
    "lint": "eslint .",
    "pack:release": "node scripts/pack-release.mjs",
    "preview:pack": "node scripts/pack-release.mjs --preview",
    "release:prepare": "changelogen --bump --clean",
    "release:verify": "pnpm audit:all && pnpm verify && pnpm pack:release && node scripts/verify-packed-consumer.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm docs:build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.1.1",
    "changelogen": "0.6.2",
    "eslint": "^10.4.1",
    "pkg-pr-new": "0.0.87",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "vitest": "^4.1.8"
  }
}
