{
  "name": "{{PACKAGE_NAME}}",
  "version": "0.1.0",
  "description": "{{DESCRIPTION}}",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "author": "Lupinum OG <info@lupinum.com> (https://lupinum.com)",
  "homepage": "https://{{DOMAIN}}",
  "repository": { "type": "git", "url": "git+https://github.com/{{REPOSITORY}}.git" },
  "bugs": { "url": "https://github.com/{{REPOSITORY}}/issues" },
  "packageManager": "pnpm@11.21.0",
  "engines": { "node": "^22.14.0 || ^24.0.0 || ^26.0.0" },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./agent-docs": "./dist/agent/AGENTS.md"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "CHANGELOG.md"],
  "publishConfig": { "access": "public" },
  "scripts": {
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "build": "tsup src/index.ts --format esm --dts --clean && pnpm docs:build && node scripts/agent-docs.mjs && publint",
    "lint": "eslint . && node scripts/lint-changesets.mjs",
    "format": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "docs:dev": "pnpm --dir docs dev",
    "docs:build": "pnpm --dir docs build",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && node scripts/audit-deps.mjs",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@nuxt/eslint-config": "^1.17.0",
    "@types/node": "26.1.1",
    "eslint": "^10.9.0",
    "pkg-pr-new": "0.0.87",
    "publint": "0.3.25",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "vitest": "^4.1.8"
  }
}
