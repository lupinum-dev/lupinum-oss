{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "releaseHistoryCutoff", "repositories"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 2 },
    "releaseHistoryCutoff": { "type": "string", "format": "date-time" },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repository", "vercelProject", "policy", "releaseProfile"],
        "properties": {
          "repository": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
          },
          "vercelProject": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "policy": { "const": "library-docs-on-demand" },
          "releaseProfile": {
            "enum": ["none", "single-package", "fixed-package-set", "independent-family"]
          },
          "canary": { "type": "boolean" }
        }
      }
    }
  }
}
