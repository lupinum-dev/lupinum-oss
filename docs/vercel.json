{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nuxtjs",
  "buildCommand": "pnpm --dir .. docs:build",
  "git": {
    "deploymentEnabled": {
      "renovate/**": false,
      "changeset-release/**": false,
      "ci/**": false
    }
  },
  "ignoreCommand": "node ../starters/_shared/library/docs/scripts/vercel-ignore.mjs . ../package.json ../pnpm-lock.yaml ../pnpm-workspace.yaml ../scripts/clean-docs-output.mjs ../scripts/verify-docs-output.mjs || exit 1",
  "outputDirectory": null
}
